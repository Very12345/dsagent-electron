{
  "name": "webagent",
  "version": "6.0.0",
  "description": "WebAgent local multi-provider agent workbench",
  "author": "WebAgent Contributors",
  "main": "src/node/daemon.js",
  "bin": {
    "webagent": "./bin/dsagent-runtime-cli.js",
    "webagent-cli": "./bin/dsagent-runtime-cli.js",
    "dsagent": "./bin/dsagent-runtime-cli.js",
    "dsagent-cli": "./bin/dsagent-runtime-cli.js"
  },
  "scripts": {
    "start": "npm run build:renderer && node src/node/daemon.js",
    "launch": "node src/node/daemon.js",
    "dev": "vite --config vite.config.js",
    "start:runtime": "node src/node/daemon.js --runtime-only",
    "dev:runtime": "node src/node/daemon.js --runtime-only",
    "build:renderer": "vite build --config vite.config.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/runtime/*.test.js && node test/datalog.test.js && node test/json-repair.test.js",
    "test:e2e": "npm run build:renderer && playwright test",
    "test:all": "npm test && npm run typecheck && npm run test:e2e",
    "smoke:cli": "node bin/dsagent-runtime-cli.js --help",
    "verify": "npm run test:all && npm run smoke:cli",
    "cli": "node --no-warnings bin/dsagent-runtime-cli.js",
    "dist": "npm run build:renderer && npm pack",
    "dist:win": "npm run dist",
    "dist:portable": "npm run dist",
    "prepack": "npm run build:renderer"
  },
  "files": [
    "bin/",
    "src/",
    "dist-renderer/",
    "tools/",
    "integrations/",
    "inject-deepseek.js",
    "agent-engine.js",
    "inject-qwen.js",
    "server*.js",
    "server.js",
    "skill-engine.js",
    "memory-store.js",
    "plugin-*.js",
    "tool-loop.js",
    "model-registry.js",
    "apikey-store.js"
  ],
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@mdi/font": "^7.4.47",
    "@myriaddreamin/typst-ts-renderer": "^0.6.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.6.0",
    "@myriaddreamin/typst.ts": "^0.6.0",
    "axios": "^1.17.0",
    "dirty-json": "0.9.2",
    "dompurify": "^3.4.13",
    "iconv-lite": "^0.6.3",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.47",
    "localtunnel": "^2.0.2",
    "mermaid": "^11.16.1",
    "qrcode-generator": "^2.0.4",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-virtuoso": "^4.12.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "ws": "^8.21.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.5-rc.1": true,
    "@google/genai@1.52.0": true,
    "esbuild@0.21.5": true,
    "koffi@3.2.1": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.4": true
  }
}
